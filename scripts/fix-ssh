#!/bin/bash

# Windows OpenSSH has no unix-domain agent socket: ssh-agent runs as a Windows
# service and is reached over a named pipe, so SSH_AUTH_SOCK is neither set nor
# used. Left to run here this would kill unrelated processes and then export a
# socket path that nothing listens on, breaking ssh rather than fixing it.
case "${OSTYPE:-}${MSYSTEM:-}" in
msys* | cygwin* | *MINGW* | *MSYS*)
	echo "fix-ssh: not applicable on Windows -- ssh-agent is a service here." >&2
	echo "Check it with:  sc query ssh-agent" >&2
	echo "Start it with:  sc config ssh-agent start=auto && net start ssh-agent" >&2
	echo "(FIDO2/YubiKey keys need no agent at all.)" >&2
	exit 0
	;;
esac

function fix_ssh {
  # check if ssh-eval has been ran

  matches=$(ps ax | grep -v "grep" | grep "ssh-agent" | awk '{print $1}')

  size=$(echo "$matches" | wc -l)

  if [[ $size -gt 0 && -n "${matches}" ]]; then
  
    i=1
    for p in $matches
    do

      if [[ $i -eq $size ]]; then
        echo "Using existing agent." 

        SSH_AGENT_PID=$p
        export SSH_AGENT_PID="$SSH_AGENT_PID"
        echo "$SSH_AGENT_PID"

        SSH_AUTH_SOCK="$HOME/.ssh/sock/.ssh-agent"
        echo "$SSH_AUTH_SOCK"
        export SSH_AUTH_SOCK="$SSH_AUTH_SOCK"

      else

        kill "$p"
        i=$((i+1))

      fi

    done

  else

    echo "Creating new agent."
    eval "$(ssh-agent -a "$HOME"/.ssh/sock/.ssh-agent)"

  fi
}

fix_ssh