#!/bin/bash

unalias -a

if [[ $OSTYPE == *"darwin"* ]]; then
	alias l="ls --color"
	alias ll="ls -l --color"
	alias la="ls -alG --color"
else
	# Git Bash ships GNU coreutils, so --group-directories-first works there
	# just as it does on linux.
	alias l="ls --color --group-directories-first"
	alias ll="ls -l --color --group-directories-first"
	alias la="ls -alG --color"
fi

alias vi="vim"
alias '?'=duckduckgo
alias gs="git status"
alias ga="git add"
alias gd="git diff"
alias gaa="git add -A"
alias gc="git commit"
alias gcb="git checkout -b"
alias gps="git push"
alias gpu="git pull"
alias gaf="ga  \$(git ls-files -m | fzf -m)"
alias gus="git restore --staged"
alias gusf="gus \$(git diff --name-only --cached | fzf -m)"
alias gdf="gd \$(git ls-files -m | fzf -m)"
alias gfu="gc --fixup \$(git log --oneline --color=never | fzf | awk '{ print \$1 }')"

# Tmux with UTF-8 support. There is no tmux under Git Bash, and aliasing a
# command that does not exist just turns "command not found" into a confusing
# "tmux: command not found" from inside the alias.
if command -v tmux &>/dev/null; then
	alias tmux="tmux -u"
fi

# Use nvim -- but only when it is actually installed. On a fresh Windows box
# nvim arrives via winget, and until it does, an unconditional alias means
# `vim` (and `vi`, which points at it) stop working altogether.
if command -v nvim &>/dev/null; then
	alias vim="nvim"
fi

# Windows: give Git Bash the same "open this with whatever handles it" verb
# that macOS spells `open` and linux spells `xdg-open`. Git Bash already ships
# /usr/bin/start for exactly this, but `unalias -a` above means we have to say
# so explicitly. `here` is deliberately not called `explorer`, which would
# shadow the real explorer.exe and force a `.` argument onto every call.
case "${OSTYPE:-}${MSYSTEM:-}" in
msys* | cygwin* | *MINGW* | *MSYS*)
	alias open="start"
	alias here="explorer.exe ."

	# tmux muscle memory, pointed at zellij (see zellij/config.kdl for why).
	# Zellij aliases `a` -> attach and `ls` -> list-sessions itself, so
	# `tmux a` and `tmux ls` carry over untouched. `tmux a -c` attaches or
	# creates, which is what `tmux new -A` did.
	#
	# Guarded on tmux being absent so that a real tmux -- a native port, say
	# -- keeps its own name and the `tmux -u` alias above still wins.
	if ! command -v tmux &>/dev/null && command -v zellij &>/dev/null; then
		alias tmux="zellij"
	fi
	;;
esac
